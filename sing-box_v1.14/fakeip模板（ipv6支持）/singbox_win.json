{
    "http_clients": [
        {
            "tag": "proxy-client",
            "detour": "Default"
        }
    ],
    "services": [
        {
            "type": "api",
            "tag": "api",
            "listen": "0.0.0.0",
            "listen_port": 9090,
            "secret": "",
            "access_control_allow_origin": [],
            "access_control_allow_private_network": false,
            "dashboard": {
                "enabled": true,
                "path": "dashboard",
                "download_url": "https://github.com/Zephyruso/zashboard/releases/latest/download/dist.zip",
                "http_client": "proxy-client",
                "update_interval": "7d"
            },
            "tls": {}
        }
    ],
    "experimental": {
        "cache_file": {
            "enabled": true
        }
    },
    "log": {
        "level": "info",
        "timestamp": true
    },
    "dns": {
        "servers": [
            {
                "tag": "proxy_dns",
                "type": "https",
                "server": "8.8.8.8",
                "detour": "Default"
            },
            {
                "tag": "cn_dns",
                "type": "https",
                "server": "223.5.5.5"
            },
            {
                "tag": "fake_dns",
                "type": "fakeip",
                "inet4_range": "11.0.0.0/16",
                "inet6_range": "3ffe::/16"
            }
        ],
        "rules": [
            {
                "rule_set": "geosite-geolocation-!cn",
                "query_type": [
                    "A",
                    "AAAA"
                ],
                "action": "route",
                "server": "fake_dns"
            },
            {
                "type": "logical",
                "mode": "or",
                "action": "route",
                "rules": [
                    {
                        "domain_suffix": [
                            ".cn"
                        ]
                    },
                    {
                        "domain_keyword": [
                            "stun",
                            "turn"
                        ]
                    },
                    {
                        "rule_set": "geosite-cn"
                    },
                    {
                        "rule_set": [
                            "geosite-games-cn",
                            "geosite-synology",
                            "geosite-nvidia-cn",
                            "geosite-apple-cn",
                            "geosite-microsoft-cn"
                        ]
                    }
                ],
                "server": "cn_dns"
            },
            {
                "action": "evaluate",
                "server": "proxy_dns"
            },
            {
                "match_response": true,
                "rule_set": "geoip-cn",
                "action": "route",
                "server": "cn_dns"
            },
            {
                "action": "route",
                "query_type": [
                    "A",
                    "AAAA"
                ],
                "server": "fake_dns",
                "rewrite_ttl": 1
            }
        ]
    },
    "inbounds": [
        {
            "type": "tun",
            "tag": "tun-in",
            "interface_name": "singbox_tun",
            "address": [
                "172.18.0.1/30",
                "fdfe:dcba:9876::1/126"
            ],
            "mtu": 9000,
            "auto_route": true,
            "route_exclude_address": [
                "10.0.0.0/8",
                "100.64.0.0/10",
                "169.254.0.0/16",
                "172.16.0.0/12",
                "192.0.0.0/24",
                "192.168.0.0/16"
            ],
            "strict_route": true,
            "stack": "mixed",
            "platform": {
                "http_proxy": {
                    "enabled": true,
                    "server": "127.0.0.1",
                    "server_port": 7890,
                    "bypass_domain": [],
                    "match_domain": []
                }
            }
        },
        {
            "type": "mixed",
            "tag": "mixed-in",
            "listen": "127.0.0.1",
            "listen_port": 7890
        }
