    "rules": [
      {
        "action": "sniff"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "protocol": "dns"
          },
          {
            "port": 53
          }
        ],
        "action": "hijack-dns"
      },
      {
        "network": "icmp",
        "outbound": "🎯 直连"
      },
      {
        "rule_set": [
          "geosite-ads",
          "geosite-httpdns"
        ],
        "action": "reject"
      },
      {
        "domain_suffix": [
          "mcdn.bilivideo.com",
          "mcdn.bilivideo.cn",
          "edge.mountaintoys.cn",
          "h2.smtcdns.net",
          "szbdyd.com"
        ],
        "action": "reject"
      },
