{
  "http_clients": [
    {
      "tag": "proxy-client",
      "detour": "Default"
    }
  ],
  "experimental": {
    "clash_api": {
      "external_controller": "0.0.0.0:9090",
      "external_ui": "ui",
      "secret": "",
      "external_ui_download_url": "https://github.com/Zephyruso/zashboard/releases/latest/download/dist.zip",
      "external_ui_download_detour": "Default",
      "default_mode": "rule"
    },
    "cache_file": {
      "enabled": true,
      "store_dns": true
    }
  },
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "final": "proxy_dns",
    "strategy": "ipv4_only",
    "optimistic": {
      "enabled": true,
      "timeout": "3d"
    },
    "servers": [
      {
        "tag": "proxy_dns",
        "type": "https",
        "server": "8.8.8.8",
        "detour": "Default"
      },
      {
        "tag": "cn_dns",
        "type": "https",
        "server": "223.5.5.5"
      },
      {
        "tag": "cn_dns2",
        "type": "https",
        "server": "1.12.12.12"
      }
    ],
    "rules": [
      {
        "rule_set": "geosite-private",
        "action": "route",
        "server": "cn_dns"
      },
      {
        "rule_set": [
          "geosite-ads",
          "geosite-httpdns"
        ],
        "action": "predefined",
        "rcode": "NXDOMAIN"
      },
      {
        "query_type": [
          "AAAA",
          "HTTPS",
          "SVCB"
        ],
        "action": "predefined",
        "rcode": "NOERROR"
      },
      {
        "clash_mode": "direct",
        "action": "route",
        "server": "cn_dns"
      },
      {
        "clash_mode": "global",
        "action": "route",
        "server": "proxy_dns"
      },
      {
        "domain_suffix": [
          "googleapis.cn",
          "push.apple.com",
          "uhdnow.com",
          "023168.xyz",
          "sexlikereal.com",
          "browserleaks.com",
          "browserleaks.org",
          "dnsleaktest.com",
          "ipleak.net",
          "whoer.net"
        ],
        "action": "route",
        "server": "proxy_dns"
      },
      {
        "rule_set": "cngames",
        "action": "route",
        "server": "cn_dns2"
      },
      {
        "domain_suffix": [
          "ileidian.com",
          "ghfast.top",
          "ottiptv.cc",
          "xiuxitong.com",
          "pc528.net",
          "tracker.m-team.cc"
        ],
        "action": "route",
        "server": "cn_dns"
      },
      {
        "rule_set": [
          "gfw",
          "aiservice",
          "telegramsite",
          "tiktok",
          "instagram",
          "netflixsite",
          "disney",
          "hbo",
          "hulu",
          "paypal",
          "emby"
        ],
        "action": "route",
        "server": "proxy_dns"
      },
      {
        "rule_set": "cnsite",
        "action": "route",
        "server": "cn_dns"
      }
    ]
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "singbox_tun",
      "address": [
        "172.18.0.1/30"
      ],
      "auto_route": true,
      "route_exclude_address": [
        "10.0.0.0/8",
        "100.64.0.0/10",
        "169.254.0.0/16",
        "172.16.0.0/12",
        "192.0.0.0/24",
        "192.168.0.0/16"
      ],
      "strict_route": true,
      "dns_mode": "hijack",
      "auto_redirect": true
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 7890
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "Default",
      "outbounds": [
        "Auto",
        "Direct-Out"
      ],
      "interrupt_exist_connections": true
    },
    {
      "type": "urltest",
      "tag": "Auto",
      "outbounds": [],
      "url": "https://www.apple.com/library/test/success.html",
      "interval": "3m",
      "tolerance": 30,
      "interrupt_exist_connections": false
    },
    {
      "type": "selector",
      "tag": "Relay",
      "outbounds": [
        "Direct-Out"
      ],
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "PayPal",
      "outbounds": [
        "Default",
        "Auto"
      ],
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "AI-Service",
      "outbounds": [
        "Default",
        "Auto"
      ],
      "interrupt_exist_connections": true
    },
    {
