        "Default",
        "Auto"
      ],
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "Streaming-Media",
      "outbounds": [
        "Default",
        "Auto"
      ],
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "Telegram",
      "outbounds": [
        "Default",
        "Auto"
      ],
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "Instagram",
      "outbounds": [
        "Default",
        "Auto"
      ],
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "Emby",
      "outbounds": [
        "Default",
        "Auto",
        "Direct-Out"
      ],
      "interrupt_exist_connections": true
    },
    {
      "type": "direct",
      "tag": "Direct-Out",
      "domain_resolver": {
        "server": "cn_dns",
        "strategy": "ipv4_only"
      }
    }
  ],
  "route": {
    "final": "Default",
    "auto_detect_interface": true,
    "default_http_client": "proxy-client",
    "default_domain_resolver": {
      "server": "cn_dns",
